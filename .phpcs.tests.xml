<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- Standalone ruleset for tests/: the shared team51-configs ruleset (see ./.phpcs.xml) carries
	     an inherited exclude-pattern for */tests/* (kept for fleet backwards compatibility), and a
	     consumer ruleset cannot override an included ruleset's exclude-pattern — only the sniffs it
	     defines itself. So tests get linted by this separate, standalone ruleset instead of extending
	     the shared dist. -->

	<!-- How to scan. -->
	<arg value="sp"/> <!-- Show sniff and progress. -->
	<arg name="colors"/> <!-- Show results with colors. -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results. -->
	<arg name="extensions" value="php"/> <!-- Only scan PHP files. -->

	<!-- Applied rulesets. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.5-"/>

	<!-- Same file-naming and file-comment customizations team51-configs' shared ruleset applies
	     project-wide (see vendor/a8cteam51/team51-configs/quality-assurance/phpcs.dist.xml): PSR-4
	     class-per-file naming doesn't fit WordPress's hyphenated-lowercase file convention, and the
	     class docblock already documents the file, so a separate file docblock is redundant. -->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<!-- House style places `declare( strict_types=1 );` inline with the opening tag, before the file docblock. -->
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
	</rule>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
	</rule>

	<!-- Check that the proper text domain is used everywhere (test fixtures call __()/_e() too). -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="a8csp-scaffold"/>
			</property>
		</properties>
	</rule>

	<!-- Test-only relaxations: tests are linted, but a few sniffs don't apply here — test classes,
	     methods, and properties carry no docblocks, fixtures legitimately override globals, and test
	     helpers need no global prefix. This ruleset only ever scans tests/, so each exclude-pattern
	     below disables the sniff for this entire ruleset. -->
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="a8csp_"/>
				<element value="a8csp_scaffold_"/>
				<element value="A8C\SpecialProjects\Scaffold"/>
			</property>
		</properties>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<!-- Test doubles and recorders must match the signature they stand in for. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<!-- Fixture classes co-locate with the test that owns them. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<!-- Test exceptions surface in CLI output, not HTML. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidHookName.UseUnderscores">
		<!-- Tests fire deliberately malformed hook names at validators. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
