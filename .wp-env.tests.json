{
  "$schema": "https://schemas.wp.org/trunk/wp-env.schema.json",
  "phpVersion": "8.5",
  "port": 8890,
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/a8csp-plugin-scaffold": ".",
    "wp-content/plugins/woocommerce": "./vendor/wpackagist-plugin/woocommerce"
  },
  "lifecycleScripts": {
    "afterStart": "bin/wp-env-install-pdo_mysql.sh && wp-env --config .wp-env.tests.json run cli wp plugin activate woocommerce a8csp-plugin-scaffold"
  },
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": true
  }
}
