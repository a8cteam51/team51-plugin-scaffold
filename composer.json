{
  "name": "a8cteam51/team51-plugin-scaffold",
  "type": "wordpress-plugin",

  "description": "A scaffold for A8C Special Projects plugins.",
  "homepage": "https://github.com/a8cteam51/team51-plugin-scaffold",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Automattic Special Projects Team",
      "homepage": "https://specialprojects.automattic.com/"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/a8cteam51/team51-plugin-scaffold/graphs/contributors"
    }
  ],

  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/a8cteam51/team51-configs"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-json": "*"
  },
  "require-dev": {
    "automattic/jetpack-changelogger": "^6",
    "phpcompatibility/phpcompatibility-wp": "^3@alpha",
    "phpcompatibility/php-compatibility": "^10@alpha",
    "phpcompatibility/phpcompatibility-paragonie": "^2@alpha",
    "a8cteam51/team51-configs": "dev-update/php85-wp70-floors as dev-trunk",
    "phpunit/phpunit": "^13",

    "wp-cli/i18n-command": "^2",

    "wpackagist-plugin/woocommerce": "10.9.*",
    "php-stubs/woocommerce-stubs": "^10",

    "roave/security-advisories": "dev-latest"
  },

  "autoload": {
    "psr-4": {
      "A8C\\SpecialProjects\\Scaffold\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "A8C\\SpecialProjects\\Scaffold\\Tests\\": "tests/"
    }
  },

  "scripts": {
    "changelog:add": "@php vendor/bin/changelogger add",
    "changelog:validate": "@php vendor/bin/changelogger validate",
    "changelog:write": "@php vendor/bin/changelogger write",
    "generate-autoloader": "@composer dump-autoload --ignore-platform-reqs -o",

    "format:php": "phpcbf --standard=./.phpcs.xml --basepath=. ./ -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpcs:tests",
      "@lint:php:phpstan",
      "@lint:php:composer-require-checker"
    ],
    "lint:php:phpcs": "phpcs --standard=./.phpcs.xml --basepath=. ./ -v",
    "lint:php:phpcs:tests": "phpcs --standard=./.phpcs.tests.xml --basepath=. ./tests -v",
    "lint:php:phpstan": "phpstan analyse -c ./.phpstan.neon -v --memory-limit=1G",
    "lint:php:composer-require-checker": "@php -d memory_limit=1G vendor/bin/composer-require-checker check --config-file=./.composer-require-checker.json ./composer.json",

    "internationalize": [
      "@i18n:makepot",
      "@i18n:updatepo",
      "@i18n:makemo",
      "@i18n:makephp"
    ],
    "i18n:makepot": "wp i18n make-pot ./ --slug=a8csp-scaffold",
    "i18n:updatepo": "wp i18n update-po ./languages/a8csp-scaffold.pot",
    "i18n:makemo": "wp i18n make-mo ./languages/",
    "i18n:makephp": "wp i18n make-php ./languages/",

    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ],

    "test": "@php vendor/bin/phpunit",
    "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
    "test:unit:mutation": "@php vendor/bin/infection --threads=max",
    "test:integration": "npm --prefix=. run test:integration",
    "test:requirements": "npm --prefix=. run test:requirements",
    "quality-check": [
      "@lint:php",
      "@test:unit"
    ],
    "quality-check:all": [
      "@quality-check",
      "@test:unit:mutation"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "infection/extension-installer": true
    }
  },

  "extra": {
    "changelogger": {
      "changelog": "CHANGELOG.md",
      "changes-dir": "changelog",
      "versioning": "semver",
      "default-type": "changed",
      "types": {
        "added": "Added",
        "changed": "Changed",
        "deprecated": "Deprecated",
        "removed": "Removed",
        "fixed": "Fixed",
        "security": "Security"
      }
    },
    "installer-paths": {
      "vendor/wpackagist-plugin/{$name}/": [
        "type:wordpress-plugin"
      ],
      "vendor/wpackagist-theme/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  }
}
